{
  "name": "@newmax-ai/pinekin",
  "version": "0.1.0",
  "private": true,
  "description": "Pinekin — 换个地方，继续思考。",
  "author": "newmax-ai",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/desktop.mjs preview",
    "import:local": "node scripts/import-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:codex-contract": "vitest run --config verification/vitest.codex.config.ts",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "entities": "8.1.0",
    "lucide-react": "1.58.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "latest",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "ai.newmax.staithe",
    "productName": "Pinekin",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/pinekin.png",
      "resources/pinekin-macos.png"
    ],
    "protocols": [
      {
        "name": "Pinekin 本地会话",
        "schemes": [
          "newmax-staithe",
          "newmax-ember"
        ]
      }
    ],
    "mac": {
      "icon": "resources/pinekin.icns",
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "icon": "resources/pinekin.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/pinekin.png",
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
